<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CzBuCHi.Teleporter</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <Version>3.0.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <GameReference Include="mscorlib;System;System.Core;netstandard;Railroader.Modding;Railroader;Core;Map.Runtime;AssetPack.Common;KeyValue.Runtime;SimpleGraph.Runtime;Newtonsoft.Json;Relay;0Harmony;UnityEngine.CoreModule;UnityEngine.ImageConversionModule;UnityEngine.UI;UnityEngine.PhysicsModule;Unity.TextMeshPro;KinematicCharacterController" />
    <Reference Include="@(GameReference)">
      <HintPath>$(GameManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="icon.png" LogicalName="Teleporter.icon.png" />
    <None Update="Info.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Scripts\*.rl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Railroader.Modding.dll')" Text="Railroader 0.6 assemblies not found. Set GameDir in Paths.user or pass -p:GameDir=..." />
    <Error Condition="!Exists('$(GameManagedDir)\0Harmony.dll')" Text="The game's bundled 0Harmony.dll is required." />
  </Target>
  <Target Name="PackageMod" AfterTargets="Publish">
    <PropertyGroup>
      <PackageRoot>$(MSBuildProjectDirectory)\obj\$(Configuration)\NativePackage</PackageRoot>
      <PackageDir>$(PackageRoot)\CzBuCHi.Teleporter</PackageDir>
      <PackageZip>$(MSBuildProjectDirectory)\..\bin\CzBuCHi.Teleporter_$(Version).zip</PackageZip>
    </PropertyGroup>
    <MakeDir Directories="$(PackageDir)\Scripts;$(MSBuildProjectDirectory)\..\bin" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\Info.json;$(MSBuildProjectDirectory)\README.md;$(MSBuildProjectDirectory)\Migrate-RailForgeProfile.ps1;$(MSBuildProjectDirectory)\..\LICENSE" DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Scripts\Main.rl" DestinationFolder="$(PackageDir)\Scripts" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Package: $(PackageZip)" />
  </Target>
</Project>
