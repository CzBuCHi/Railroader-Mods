<Project>
  <PropertyGroup>
    <IsMod Condition="'$(IsMod)' == ''">false</IsMod>
    <PackageMod Condition="'$(PackageMod)' == ''">enable</PackageMod>
    <GameModDir Condition="'$(GameModDir)' == ''">$(GameDir)/Mods/$(AssemblyName)</GameModDir>
  </PropertyGroup>

  <!-- Keep the original reference declarations available for other projects. -->
  <ItemGroup>
    <Reference Include="@(GameAssembly)">
      <HintPath Condition="Exists('$(GameManagedDir)/%(Identity).dll')">$(GameManagedDir)/%(Identity).dll</HintPath>
      <HintPath Condition="Exists('$(GameManagedDir)/UnityModManager/%(Identity).dll')">$(GameManagedDir)/UnityModManager/%(Identity).dll</HintPath>
      <HintPath Condition="Exists('$(GameManagedDir)/%(Identity).exe')">$(GameManagedDir)/%(Identity).exe</HintPath>
      <HintPath Condition="Exists('$(GameDir)/Mods/%(Identity)/%(Identity).dll')">$(GameDir)/Mods/%(Identity)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ModReference Include="@(ModAssembly)">
      <AssemblyName>$([System.IO.Path]::GetFileNameWithoutExtension('%(Identity)'))</AssemblyName>
      <FullModPath>$(GameDir)/Mods/%(Identity)</FullModPath>
    </ModReference>
    <Reference Include="@(ModReference->'%(AssemblyName)')">
      <HintPath Condition="Exists('%(FullModPath)')">%(FullModPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <UsingTask TaskName="ValidateRailForgePackage" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
      <ManifestPath ParameterType="System.String" Required="true" />
      <ExpectedVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var actual = AssemblyName.GetAssemblyName(AssemblyPath).Version.ToString(3);
        var match = Regex.Match(File.ReadAllText(ManifestPath), @"""version""\s*:\s*""([^""]+)""");
        if (!match.Success || match.Groups[1].Value != ExpectedVersion || actual != ExpectedVersion)
        {
            Log.LogError("Assembly, manifest, and project versions must match: " + AssemblyPath);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateModPublish" BeforeTargets="PackageMod"
          Condition="'$(IsMod)' == 'true' And '$(PackageMod)' == 'enable'">
    <ValidateRailForgePackage AssemblyPath="$(TargetPath)"
                             ManifestPath="$(MSBuildProjectDirectory)/Definition.json"
                             ExpectedVersion="$(Version)" />
    <Exec Condition="'$(MSBuildProjectName)' == 'TurntableControl'"
          Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)tests/TurntableControl.Tests/TurntableControl.Tests.csproj&quot; -c &quot;$(Configuration)&quot;" />
    <Exec Condition="'$(MSBuildProjectName)' == 'Tweaks'"
          Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)tests/Tweaks.Tests/Tweaks.Tests.csproj&quot; -c &quot;$(Configuration)&quot; -p:GameDir=&quot;$(GameDir)&quot; -- &quot;$(GameManagedDir)/Assembly-CSharp.dll&quot;" />
  </Target>

  <!-- Publish creates a local installable archive; it does not deploy or create a GitHub release. -->
  <Target Name="PackageMod" AfterTargets="Publish"
          Condition="'$(IsMod)' == 'true' And '$(PackageMod)' == 'enable'">
    <PropertyGroup>
      <_PackageStage>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/$(Configuration)/RailForgePackage'))</_PackageStage>
      <_PackageModDir>$(_PackageStage)/Mods/$(AssemblyName)</_PackageModDir>
      <_PackageBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)bin'))</_PackageBin>
      <ZipName>$(_PackageBin)/$(AssemblyName)_$(Version).zip</ZipName>
    </PropertyGroup>
    <Error Condition="!$(_PackageStage.StartsWith('$(MSBuildProjectDirectory)'))"
           Text="Package staging must stay inside the project directory." />
    <RemoveDir Directories="$(_PackageStage)" />
    <MakeDir Directories="$(_PackageModDir)/docs;$(_PackageBin)" />
    <ItemGroup>
      <_PackageFile Include="$(TargetPath)" />
      <_PackageFile Include="$(MSBuildProjectDirectory)/Definition.json" />
      <_PackageFile Include="$(MSBuildThisFileDirectory)LICENSE" />
      <_PackageFile Include="$(MSBuildProjectDirectory)/README.md" />
      <_PackageFile Include="$(MSBuildProjectDirectory)/PrankTexts.txt"
                    Condition="Exists('$(MSBuildProjectDirectory)/PrankTexts.txt')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageFile)" DestinationFolder="$(_PackageModDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Docs/$(MSBuildProjectName).md"
          DestinationFolder="$(_PackageModDir)/docs" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Docs/MainPanel.png"
          DestinationFolder="$(_PackageModDir)/docs" Condition="'$(MSBuildProjectName)' == 'Tweaks'" />
    <ZipDirectory SourceDirectory="$(_PackageStage)" DestinationFile="$(ZipName)" Overwrite="true" />
    <Message Text="Package: $(ZipName)" Importance="high" />
  </Target>
</Project>
