<Project>
  <Import Project="$(MSBuildThisFileDirectory)Paths.user" Condition="Exists('$(MSBuildThisFileDirectory)Paths.user')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam\steamapps\common\Railroader</GameDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameDir)\Railroader_Data\Managed</GameManagedDir>
    <RailForgeDir Condition="'$(RailForgeDir)' == ''">$(GameDir)\Mods\RTM.RailForge</RailForgeDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Version>2.0.4</Version>
  </PropertyGroup>
</Project>
